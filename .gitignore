.DS_Store

# Build outputs of the empirical pipeline (regenerated by
# build_shock_series / fetch_outcome_data / assemble_dataset).
empirical/data/ea_dataset*.mat

# Outcome series downloaded from Eurostat / the ECB Data Portal.  These
# are third-party data, fetched by fetch_outcome_data; they are not
# redistributed with the repo.  The EA-EMPD event file IS shipped.
empirical/data/raw/*.csv
!empirical/data/raw/ea_empd_events.csv
empirical/data/raw/rejected/

# Monte Carlo chunk files and worker logs (intermediate; the merged
# results/mc_*.mat and the csv exports are what gets committed)
results/chunks/
results/grid/logs/
empirical/data/SYNTHETIC_*

# Null-calibration checkpoint (intermediate; results/null_calibration.mat
# and null_thresholds.csv are the outputs)
results/null_ckpt*.mat

# Octave leaves this behind on abnormal exit
octave-workspace

# smoke-preset outputs are throwaway
results/mc_smoke_*
