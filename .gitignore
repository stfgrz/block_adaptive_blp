.DS_Store

# --- local tool settings -----------------------------------------------------
.claude/

# --- empirical data ----------------------------------------------------------
# Assembled datasets are rebuilt by assemble_dataset_v2 / the legacy builders.
empirical/data/ea_dataset*.mat
# Outcome and indicator series downloaded from Eurostat / the ECB Data Portal
# (third-party data, not redistributed; fetch_outcome_data / ea_fetch_v2_series /
# are the provenance sidecars and the derived monthly instrument panel.
empirical/data/raw/*.csv
empirical/data/raw/*.xlsx
!empirical/data/raw/ea_empd_events.csv
!empirical/data/raw/ea_empd_events_full.csv
!empirical/data/raw/*.source.txt
empirical/data/raw/rejected/
empirical/data/SYNTHETIC_*

# --- intermediate results ------------------------------------------------------
# Monte Carlo chunk files and worker logs (the merged mc_*.mat and csv exports
# are what gets committed)
results/simulation/chunks/
results/simulation/grid/logs/
# Null-calibration checkpoints (the finished null_calibration_*.mat is the output)
results/**/null_ckpt*.mat
# QUICK = true runs of RUN_EMPIRICAL_IV are interface checks, never results
results/**/*_quick*
# smoke-preset Monte Carlo outputs are throwaway
results/**/mc_smoke_*

# --- build artefacts --------------------------------------------------------------
presentation/build/
octave-workspace
